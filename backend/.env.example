# JANSEVA Backend — Environment Variables
#
# Copy this file to .env and fill in production-appropriate values.
#
# IMPORTANT: Generate cryptographically secure secrets for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ─── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────
# Development: mongodb://127.0.0.1:27017/citizen_grievance
# Production:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/citizen_grievance?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/citizen_grievance

# ─── Authentication ──────────────────────────────────
# MUST be ≥ 32 characters in production. Generate with the command above.
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes
JWT_EXPIRE=7d

# ─── Admin Seed Account ─────────────────────────────
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@janseva.gov.in
# MUST be changed in production. Minimum 12 characters recommended.
ADMIN_PASSWORD=CHANGE_ME_use_strong_password

# ─── AI Service ──────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Frontend URL (CORS allowlist) ───────────────────
FRONTEND_URL=http://localhost:4200

# ─── Observability (Optional) ────────────────────────
# SENTRY_DSN=https://<key>@sentry.io/<project>
# LOG_LEVEL=info

# ─── Auth Bypass (TESTING ONLY — never set in production) ──
# BYPASS_AUTH=true
