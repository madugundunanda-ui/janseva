# ==============================================================================
# JANSEVA Platform — Production Environment Configuration
# ==============================================================================
# WARNING: Do not commit actual secrets to version control. Fill these values 
# in on your secure deployment platform (Railway, Render, AWS, Heroku, etc.).

# ─── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database Configuration ───────────────────────────────────────────────────
# MongoDB Atlas Connection String
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/janseva?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://janseva_prod_user:SECURE_PASSWORD_HERE@cluster.mongodb.net/janseva?retryWrites=true&w=majority

# ─── Security Configuration ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters in production mode.
JWT_SECRET=GENERATE_AND_PLACE_A_64_CHARACTER_RANDOM_HEX_SECRET_HERE
JWT_EXPIRE=7d

# Auth Bypass Protection (Strictly false in production)
BYPASS_AUTH=false

# ─── AI Service Configuration ─────────────────────────────────────────────────
# URL of the deployed Flask AI service container
AI_SERVICE_URL=https://ai.janseva.gov.in

# ─── Frontend Integration ─────────────────────────────────────────────────────
# Allowed CORS origins
FRONTEND_URL=https://janseva.gov.in

# ─── Sentry Observability ─────────────────────────────────────────────────────
# DSN from your Sentry project settings
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0000000

# ─── Logging & Audit ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Admin Account Initialization ─────────────────────────────────────────────
# Automatically seeded on fresh DB startup
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@janseva.gov.in
ADMIN_PASSWORD=CHOOSE_A_VERY_SECURE_PASSWORD_HERE
